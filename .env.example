# ─── Firebase ────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Google Maps ─────────────────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=

# ─── Push notifications (VAPID — clave pública) ──────────────────────────────
VITE_VAPID_PUBLIC_KEY=

# ─── App Check (opcional hasta registrar la Web app en Firebase Console →
# App Check → reCAPTCHA v3, que genera esta site key sola) ────────────────────
VITE_RECAPTCHA_SITE_KEY=

# ─── Observabilidad (opcional — captura de errores en producción con Sentry).
# Sin este DSN no se inicializa nada (ni en dev). Se obtiene creando un proyecto
# React en sentry.io → Settings → Client Keys (DSN). ─────────────────────────
VITE_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# Secretos de Cloud Functions (NO van acá — no son variables de cliente).
# Se configuran con: firebase functions:secrets:set <NOMBRE>
#   RESEND_API_KEY      — envío de emails (Resend)
#   VAPID_PUBLIC_KEY    — web push (servidor)
#   VAPID_PRIVATE_KEY   — web push (servidor)
#   ORS_KEY             — OpenRouteService (ruteo del despacho, server-side)
# ─────────────────────────────────────────────────────────────────────────────
