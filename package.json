{
  "name": "rolito-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc --noEmit -p functions/tsconfig.json",
    "lint": "eslint src",
    "lint:functions": "eslint functions/src",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:rules",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore --project demo-rolito \"node --test tests/firestore-rules.test.js\"",
    "test:storage-rules": "npx --yes firebase-tools emulators:exec --only firestore,storage --project demo-rolito \"node --test tests/storage-rules.test.js\"",
    "emulators": "npx --yes firebase-tools emulators:start --only auth,firestore,storage --project rolito-app --import=./emulator-data --export-on-exit=./emulator-data",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "seed:dia": "node scripts/seed-dia-caja.mjs",
    "emular:arca": "node scripts/emular-arca.mjs",
    "prepare": "husky",
    "test:coverage": "vitest run --coverage",
    "manuales": "node scripts/manuales/armar.mjs"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": "eslint --fix",
    "functions/src/**/*.ts": "eslint --fix"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-select": "^2.3.1",
    "@react-google-maps/api": "^2.19.3",
    "@sentry/react": "^10.72.0",
    "@tanstack/react-query": "^5.100.10",
    "@types/web-push": "^3.6.4",
    "@zxing/browser": "^0.2.1",
    "firebase": "^12.19.0",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.14.0",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@types/google.maps": "^3.64.0",
    "@types/node": "^26.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.2.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
