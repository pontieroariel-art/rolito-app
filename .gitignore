# Dependencias
node_modules/

# Build
dist/
dist-ssr/
*.local

# Variables de entorno (nunca commitear)
.env.local
.env*.local

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Logs
*.log
npm-debug.log*

# Local Netlify folder
.netlify

# Claude Code — settings locales (pueden contener datos sensibles)
.claude/settings.local.json

# Scripts — credenciales y archivos locales
scripts/serviceAccount.json
scripts/import-errores.txt
scripts/import-heladeras-log.txt
# Cruces/fixes con datos reales de clientes (razón social, dirección, código).
# NO versionar: el dato vive en Firestore, no en el repo.
scripts/razon-social-fix.json
scripts/*-fix.json

# Scripts/tango — exports/cruces con datos reales de clientes (CUIT, mail, tel)
scripts/tango/*.json
scripts/tango/*.csv
# ...salvo la plantilla de config del bridge (sin secretos, solo placeholders)
!scripts/tango/*.example.json

# Firebase cache
.firebase/

# Datos exportados del emulador local (npm run emulators)
/emulator-data/

# Screenshots de verificación y Playwright
.verify_screenshots/
.playwright-mcp/
/*.png
/*.jpg

# Reportes de test (Playwright / Vitest)
/test-results/
/playwright-report/
/blob-report/
/coverage/

# Certificados y claves privadas (ARCA/AFIP, firma de comprobantes, cualquier otro).
# NUNCA commitear: la clave privada del certificado fiscal permite emitir facturas
# electrónicas reales a nombre de la empresa. Van en secrets de Cloud Functions
# (firebase functions:secrets:set), igual que TANGO_BRIDGE_SECRET.
*.crt
*.key
*.pem
*.pfx
*.p12
*.csr
certs/
!**/*.example.key

# Salida de auditorías con datos reales de clientes (CUIT, razón social)
scripts/arca/salida/
