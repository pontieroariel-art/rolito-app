rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sesión "Ver como" del super_admin (2026-09-10): la callable
    // crearTokenImpersonacion emite un custom token del usuario observado con
    // el claim `impersonadoPor`. Esa sesión lee exactamente lo que lee esa
    // persona, pero NUNCA escribe: los helpers de rol devuelven "nada" en
    // create/update/delete, y las escrituras que se autorizan solo por uid o
    // email (sin rol) llevan `!esEscrituraImpersonada()` explícito.
    function esEscrituraImpersonada() {
      return request.auth != null
        && 'impersonadoPor' in request.auth.token
        && request.method in ['create', 'update', 'delete'];
    }

    // Lee el rol del usuario autenticado desde su propio documento.
    // Usa exists() antes de get() para no fallar si el doc aún no existe.
    // Soporta campo nuevo 'rol' y campo viejo 'role' por compatibilidad.
    function myRole() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      let data = exists(path) ? get(path).data : {};
      return esEscrituraImpersonada() ? 'none' : data.get('rol', data.get('role', 'none'));
    }
    // Roles ADICIONALES al principal (2026-09-07): hoy solo los de expedición
    // (caja / muelle / seguridad), para personal que cubre el mostrador además
    // de su puesto (Lucas: logística + caja). Solo los escribe el super_admin
    // (ver rolesExtraUnchanged en /users). hasRol() es la pregunta correcta
    // para esos tres roles; el resto sigue mirando el rol principal.
    function myRolesExtra() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      let data = exists(path) ? get(path).data : {};
      return esEscrituraImpersonada() ? [] : data.get('rolesExtra', []);
    }
    function hasRol(r) {
      return myRole() == r || r in myRolesExtra();
    }

    // Lee el estado ('activo'/'inactivo'/'pendiente') del usuario autenticado.
    function myEstado() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      let data = exists(path) ? get(path).data : {};
      return esEscrituraImpersonada() ? 'none' : data.get('estado', 'none');
    }

    // Área de taller del usuario autenticado (solo aplica a rol 'heladeras').
    function myArea() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      let data = exists(path) ? get(path).data : {};
      return data.get('area', null);
    }

    // Usuario autenticado que NO es una sesión anónima. La página pública de
    // turnos (/turnos/{planta}) entra con signInAnonymously SOLO para leer
    // turnosPublicos/{planta} (doc sanitizado). Las colecciones que abren a
    // "cualquier autenticado" (catálogo, visitas, flota, config) tienen que
    // seguir cerradas a esas sesiones anónimas — antes de habilitar el
    // proveedor Anonymous, `request.auth != null` equivalía a "usuario real";
    // ahora hay que exigirlo explícito. Los roles de staff/cliente entran con
    // provider 'password', nunca 'anonymous'.
    function esNoAnonimo() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Gerente comercial: acuerdos de precios y activación de clientes
    function isGerenteComercial() {
      return myRole() == 'gerente_comercial';
    }

    // Gerente general: visibilidad total + aprobación de clientes (sin operación)
    function isGerenteGeneral() {
      return myRole() == 'gerente_general';
    }

    // Usuarios con acceso de gestión
    function isManager() {
      return myRole() in ['super_admin', 'gerente_comercial', 'comercial'];
    }

    // Usuarios con acceso operativo (pedidos y logística)
    function isOperator() {
      return myRole() in ['super_admin', 'logistica'];
    }

    // Facturación: solo lectura sobre pedidos y clientes
    function isFacturacion() {
      return myRole() == 'facturacion';
    }

    // Tesorería (2026-09-09): ve en vivo ventas/cobranzas/liquidaciones y
    // valida las rendiciones de ventanilla. No es facturación.
    function isTesoreria() {
      return myRole() == 'tesoreria';
    }

    // Puede autorizar anulaciones de facturas de ventanilla (nota de crédito,
    // 2026-09-09): permiso INDIVIDUAL (users.autorizaAnulaciones), sea cual
    // sea el rol; lo asigna solo el super_admin. super_admin siempre puede.
    function puedeAutorizarAnulaciones() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      let data = exists(path) ? get(path).data : {};
      return !esEscrituraImpersonada()
        && (data.get('rol', 'none') == 'super_admin' || data.get('autorizaAnulaciones', false) == true);
    }

    // Cualquier rol de staff (todo lo que no sea cliente).
    function isStaff() {
      return myRole() != 'cliente' && myRole() != 'none';
    }

    // Sector heladeras: personal de taller y su encargado
    function isHeladeras() {
      return myRole() == 'heladeras';
    }
    function isHeladerasEncargado() {
      return myRole() == 'heladeras_encargado' || myRole() == 'super_admin';
    }
    // Acceso completo al módulo heladeras (más allá del taller): encargado,
    // super_admin y gerente_comercial (por pedido explícito del negocio,
    // gerente_comercial tiene el mismo nivel que el encargado acá).
    function isHeladerasFullAccess() {
      return isHeladerasEncargado() || isGerenteComercial();
    }
    // Técnico de campo (rol nuevo, distinto del personal de taller).
    function isTecnico() {
      return myRole() == 'tecnico';
    }
    // Operario de producción de hielo en planta.
    function isProduccion() {
      return myRole() == 'produccion_hielo';
    }
    // Encargado de producción — mismo criterio que isHeladerasEncargado().
    function isProduccionEncargado() {
      return myRole() == 'produccion_encargado' || myRole() == 'super_admin';
    }
    // Personal de caja en planta (módulo expedición: remitos de carga,
    // ventanilla, liquidaciones). Fijo por planta — ver myPlanta().
    function isCaja() {
      return hasRol('caja');
    }
    // Expedición por planta (2026-09-06): caja / muelle / seguridad solo en SU
    // planta; el super_admin (sin planta en el perfil) opera cualquiera, porque
    // las rutas /caja, /muelle y /seguridad lo admiten y antes la base lo
    // rechazaba (Ariel no podía emitir un remito de carga).
    function isCajaDe(planta) {
      return (isCaja() && planta == myPlanta()) || myRole() == 'super_admin';
    }
    function isMuelleDe(planta) {
      return (isMuelle() && planta == myPlanta()) || myRole() == 'super_admin';
    }
    function isSeguridadDe(planta) {
      return (isSeguridad() && planta == myPlanta()) || myRole() == 'super_admin';
    }
    // Personal de muelle en planta (módulo expedición: entrega la carga
    // contra el remito y cuenta la descarga al volver el camión).
    function isMuelle() {
      return hasRol('muelle');
    }
    // Personal de seguridad en el portón (módulo expedición: controla y
    // libera lo que sale cargado de la planta).
    function isSeguridad() {
      return hasRol('seguridad');
    }
    // Supervisor de cobranzas en la calle: cobra cta. cte. con composición de
    // saldos de Tango, imputación de facturas, cheques y retenciones.
    function isSupervisor() {
      return myRole() == 'supervisor';
    }
    // ── Envases retornables del camión (2026-09-07) ──
    // Remito: composición que sale (tarimas de madera, pallets de metal,
    // números de rack). Descarga: lo que volvió, contado suelto. Las reglas no
    // pueden iterar la lista de racks: se controla que sea lista, con tope y
    // sin repetidos (la app garantiza enteros > 0). Tope espejado en
    // src/utils/envases.ts (MAX_RACKS_POR_VIAJE).
    function racksOk(r) {
      return r is list && r.size() <= 60 && r.toSet().size() == r.size();
    }
    function envasesCargaOk(e) {
      return e is map && e.keys().hasOnly(['tarimasMadera', 'palletsMetal', 'racks'])
        && e.tarimasMadera is int && e.tarimasMadera >= 0
        && e.palletsMetal is int && e.palletsMetal >= 0
        && racksOk(e.racks);
    }
    function envasesDescargaOk(e) {
      return e is map && e.keys().hasOnly(['tarimasMadera', 'palletsMetal', 'puntales', 'aros', 'racks'])
        && e.tarimasMadera is int && e.tarimasMadera >= 0
        && e.palletsMetal is int && e.palletsMetal >= 0
        && e.puntales is int && e.puntales >= 0
        && e.aros is int && e.aros >= 0
        && racksOk(e.racks);
    }
    // palletsCarga del remito = tarimasMadera + palletsMetal (lo leen TV,
    // seguridad, chofer y Tango).
    function palletsCoherentes(d) {
      return d.palletsCarga is int && d.palletsCarga >= 0
        && d.palletsCarga == d.envases.tarimasMadera + d.envases.palletsMetal;
    }
    // Planta asignada al usuario autenticado (roles 'produccion_hielo' y 'caja').
    function myPlanta() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      let data = exists(path) ? get(path).data : {};
      return data.get('planta', null);
    }
    function isChofer() {
      return myRole() == 'chofer';
    }
    function isCliente() {
      return myRole() == 'cliente';
    }
    // Bridge de Tango — cuenta de servicio que corre en la VM de Tango, sin
    // rol de UI (nunca loguea por la app). Se identifica con un flag booleano
    // propio en vez de myRole(), para no tocar UserRole ni la navegación de
    // la app por una cuenta que no la usa. Ver docs/tango/INTEGRACION.md §7.
    function isTangoBridge() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      let data = exists(path) ? get(path).data : {};
      return data.get('tangoBridge', false) == true;
    }

    // Pipeline de taller de heladeras — catálogo configurable
    // (config/pasosTaller, mismo doc que edita el encargado desde
    // "Catálogos de service"), replica la lógica de
    // src/utils/heladeraPipeline.ts. Cualquier cambio ahí tiene que
    // reflejarse acá también.
    function pasoDe(pasoId) {
      let path = /databases/$(database)/documents/config/pasosTaller;
      let data = exists(path) ? get(path).data : {};
      return data.get('pasos', {}).get(pasoId, null);
    }

    // Agarrar el paso actual: desde en_taller, sin nadie más en proceso,
    // área propia == área del paso (tomada del perfil, no de lo que mande
    // el cliente). pasoActualId no cambia.
    function puedeAgarrarPasoActual() {
      let paso = pasoDe(resource.data.get('pasoActualId', null));
      return isHeladeras() && paso != null && myArea() == paso.area
        && resource.data.estado == 'en_taller'
        && resource.data.get('enProceso', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enProceso', 'updatedAt'])
        && request.resource.data.pasoActualId == resource.data.pasoActualId
        && request.resource.data.enProceso.uid == request.auth.uid
        && request.resource.data.enProceso.nombre is string
        && request.resource.data.enProceso.area == paso.area;
    }

    // Soltar (paso simple) o aprobar (paso con requiereAprobacion) tienen la
    // misma forma de escritura: avanza a paso.siguientePasoId, o pasa a
    // 'disponible' si era el último paso activo del pipeline. Solo quien lo
    // tiene agarrado; historial append-only (solo suma una entrada).
    function puedeAvanzarPasoActual() {
      let paso = pasoDe(resource.data.get('pasoActualId', null));
      let siguiente = paso == null ? null : paso.get('siguientePasoId', null);
      let nuevoEstado = siguiente == null ? 'disponible' : 'en_taller';
      return isHeladeras() && paso != null && myArea() == paso.area
        && resource.data.estado == 'en_taller'
        && resource.data.get('enProceso', null) != null
        && resource.data.enProceso.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'pasoActualId', 'enProceso', 'historialAcciones', 'updatedAt'])
        && request.resource.data.estado == nuevoEstado
        && request.resource.data.get('pasoActualId', null) == siguiente
        && request.resource.data.get('enProceso', null) == null
        && request.resource.data.historialAcciones.size() == resource.data.historialAcciones.size() + 1;
    }

    // Rechazar: solo pasos con requiereAprobacion (ej. control de calidad).
    // Vuelve a primerPasoId (snapshot tomado al alta) para un
    // reprocesamiento completo — no hay salto a mitad de pipeline.
    // cicloActual solo puede subir de a uno.
    function puedeRechazarPasoActual() {
      let paso = pasoDe(resource.data.get('pasoActualId', null));
      return isHeladeras() && paso != null && paso.get('requiereAprobacion', false) == true
        && myArea() == paso.area
        && resource.data.estado == 'en_taller'
        && resource.data.get('enProceso', null) != null
        && resource.data.enProceso.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'pasoActualId', 'enProceso', 'cicloActual', 'historialAcciones', 'updatedAt'])
        && request.resource.data.estado == 'en_taller'
        && request.resource.data.pasoActualId == resource.data.get('primerPasoId', null)
        && request.resource.data.get('enProceso', null) == null
        && request.resource.data.cicloActual == resource.data.get('cicloActual', 1) + 1
        && request.resource.data.historialAcciones.size() == resource.data.historialAcciones.size() + 1;
    }

    // ── Colección de usuarios ──────────────────────────────────────────────
    match /users/{userId} {
      function isSelf() { return request.auth != null && request.auth.uid == userId; }

      // Campos privilegiados que un no-super_admin NO puede alterar sobre un
      // documento existente. Se comparan con get() para tolerar campos ausentes.
      function rolUnchanged()    { return request.resource.data.rol == resource.data.rol; }
      // Roles adicionales y planta también son privilegio (dan acceso al
      // módulo expedición de esa planta): solo el super_admin los toca.
      function rolesExtraUnchanged() {
        return request.resource.data.get('rolesExtra', []) == resource.data.get('rolesExtra', [])
            && request.resource.data.get('planta', null) == resource.data.get('planta', null);
      }
      function estadoUnchanged() { return request.resource.data.estado == resource.data.estado; }
      // El permiso de autorizar anulaciones también es privilegio: solo super_admin.
      function autorizaAnulacionesUnchanged() {
        return request.resource.data.get('autorizaAnulaciones', false) == resource.data.get('autorizaAnulaciones', false);
      }
      function preciosUnchanged() {
        return request.resource.data.get('listaPreciosId', '') == resource.data.get('listaPreciosId', '')
            && request.resource.data.get('preciosCustom', {}) == resource.data.get('preciosCustom', {});
      }
      // Campos de identidad / internos que el cliente NO puede alterar sobre su
      // propio documento (sí pueden hacerlo managers/logística).
      function identidadUnchanged() {
        return request.resource.data.get('cuit', '')           == resource.data.get('cuit', '')
            && request.resource.data.get('codigoCliente', '')  == resource.data.get('codigoCliente', '')
            && request.resource.data.get('codVendedor', '')    == resource.data.get('codVendedor', '')
            && request.resource.data.get('sector', '')         == resource.data.get('sector', '')
            && request.resource.data.get('creadoPor', null)    == resource.data.get('creadoPor', null);
      }
      // El flag de bridge de Tango (isTangoBridge()) da acceso al pipeline de
      // Tango (tango-outbox, config/tango). Solo lo setea el Admin SDK al
      // aprovisionar la cuenta de servicio; nadie puede auto-otorgárselo
      // editando su propio perfil.
      function tangoBridgeUnchanged() {
        return request.resource.data.get('tangoBridge', false) == resource.data.get('tangoBridge', false);
      }

      // El documento objetivo es un CLIENTE (no otro staff ni un super_admin).
      // Cierra el lockout de admin y la edición cruzada de cuentas de personal:
      // las ramas de staff de abajo SOLO aplican sobre users con rol 'cliente'.
      function targetEsCliente() {
        return resource.data.get('rol', 'cliente') == 'cliente';
      }

      // Campos que el staff (comercial/gerente_comercial/logistica) puede editar
      // sobre un cliente. codigoCliente ahora es de gestión compartida (antes
      // era exclusivo de facturación). Sigue excluyendo identidad real
      // (cuit, codVendedor, sector), credenciales/login (email, dni, username)
      // y rol.
      function camposGestionClienteOk() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'razonSocial', 'nombreContacto', 'nombre', 'telefono',
          'estado', 'fechaAprobacion', 'aprobadoPor',
          'listaPreciosId', 'preciosCustom', 'vigenciaCustom', 'ultimoCambioPrecio',
          'esVisita', 'frecuenciaVisita',
          'addresses', 'lat', 'lng', 'coordPendiente',
          'notasContacto', 'codigoCliente', 'condicionVenta',
        ]);
      }

      // ── Lectura ──
      allow read: if isSelf();
      // Gestión y operación con acceso amplio legítimo (ven/administran todo el
      // personal). gerente_comercial/super_admin entran por isManager().
      allow read: if request.auth != null
        && (isManager() || myRole() == 'logistica' || isFacturacion() || isGerenteGeneral()
            // heladeras_encargado necesita buscar clientes (asignación de equipos)
            // y ver la lista de técnicos.
            || myRole() == 'heladeras_encargado'
            // produccion_encargado necesita ver la lista de operarios de planta.
            || myRole() == 'produccion_encargado');
      // Chofer (vende en la calle → remito) y caja (remitos de carga +
      // ventanilla) solo necesitan CLIENTES y CHOFERES, no el resto del personal
      // ni sus datos. Acotado por rol del target (auditoría 2026-08-29, H11): sus
      // queries ya filtran where rol=='cliente' / where rol=='chofer', así que
      // esto no cambia lo que ven, solo cierra el acceso al resto de la colección.
      allow read: if request.auth != null && (myRole() == 'chofer' || isCaja())
        && resource.data.get('rol', 'cliente') in ['cliente', 'chofer'];
      // Supervisor de cobranzas: solo necesita el padrón de CLIENTES (a quién
      // cobra); mismo criterio de acotamiento por rol del target que chofer/caja.
      allow read: if request.auth != null && isSupervisor()
        && resource.data.get('rol', 'cliente') == 'cliente';

      // ── super_admin: control total (asigna roles, crea staff, limpia datos) ──
      allow read, write: if request.auth != null && myRole() == 'super_admin';

      // ── Alta del propio documento ──
      // Registro público: el usuario SOLO puede crearse como 'cliente'.
      // El alta de staff la escribe un super_admin (regla de arriba) y la de
      // choferes un operador (regla siguiente); nunca el propio usuario nuevo.
      allow create: if isSelf() && request.resource.data.rol == 'cliente';

      // Operadores (super_admin/logistica) pueden dar de alta choferes.
      allow create: if request.auth != null && isOperator()
        && request.resource.data.rol == 'chofer';

      // Acceso completo al módulo heladeras (encargado/gerente_comercial, además
      // de super_admin que ya tiene control total arriba) puede dar de alta técnicos.
      allow create: if request.auth != null && isHeladerasFullAccess()
        && request.resource.data.rol == 'tecnico';

      // produccion_encargado puede dar de alta operarios de producción
      // (super_admin ya tiene control total arriba).
      allow create: if request.auth != null && isProduccionEncargado()
        && request.resource.data.rol == 'produccion_hielo';

      // ── Edición del propio perfil: NO puede tocar rol / estado / precios / identidad ──
      allow update: if isSelf() && !esEscrituraImpersonada()
        && rolUnchanged() && rolesExtraUnchanged() && estadoUnchanged()
        && preciosUnchanged() && identidadUnchanged() && tangoBridgeUnchanged() && autorizaAnulacionesUnchanged();

      // ── gerente_comercial / comercial / logistica: gestión de clientes ──
      // Solo sobre documentos de CLIENTE y solo los campos de gestión (nunca
      // identidad, login ni rol). Antes estas ramas permitían editar cualquier
      // documento —incluido el de un super_admin— con cualquier campo salvo rol.
      allow update: if request.auth != null
        && myRole() in ['gerente_comercial', 'comercial', 'logistica']
        && targetEsCliente()
        && camposGestionClienteOk();

      // ── gerente_general: aprobar/rechazar clientes (solo estado, solo clientes) ──
      allow update: if request.auth != null && isGerenteGeneral()
        && targetEsCliente()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'fechaAprobacion', 'aprobadoPor']);

      // ── facturacion: asignar código interno de facturación (solo ese campo) ──
      allow update: if request.auth != null && isFacturacion()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['codigoCliente']);

      // ── Módulo heladeras: activar/desactivar cuentas de técnico (solo ese
      // campo, solo sobre docs con rol 'tecnico' — no pueden tocar otro staff). ──
      allow update: if request.auth != null && isHeladerasFullAccess()
        && resource.data.get('rol', '') == 'tecnico'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']);

      // ── Producción: activar/desactivar cuentas de operario (solo ese campo,
      // solo sobre docs con rol 'produccion_hielo'). ──
      allow update: if request.auth != null && isProduccionEncargado()
        && resource.data.get('rol', '') == 'produccion_hielo'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']);
    }

    // ── Pedidos ────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // El cliente solo puede crear pedidos pendientes para sí mismo
      // El staff puede crear pedidos para cualquier cliente en cualquier estado
      allow create: if request.auth != null && (
        (
          request.resource.data.clientId == request.auth.uid
          && request.resource.data.status == 'pendiente'
          // Solo un cliente activo puede crear pedidos (bloquea a pendientes/
          // inactivos y a roles no-cliente que también cumplirían clientId==uid).
          && myRole() == 'cliente'
          && myEstado() == 'activo'
          // El cliente no puede autoasignarse un chofer al crear.
          && request.resource.data.get('driverId', null) == null
          // Ni fabricar campos que son solo de staff (PDF, reprogramación,
          // entrega, OC, historial de acciones, etc.).
          && !request.resource.data.keys().hasAny([
               'origenPdf', 'origenManual', 'origenRecurrente', 'historialAcciones',
               'reprogramado', 'reasignado', 'fechaOriginal', 'motivoReprogramacion',
               'choferOriginal', 'motivoReasignacion', 'entregaParcial',
               'productosEntregados', 'notaEntrega', 'numeroOC', 'fechaEmision',
               'fechaTope', 'motivoCancelacion'
             ])
        ) ||
        isOperator() ||
        isManager() ||
        // Supervisor en la calle (2026-09-07): toma un pedido de un cliente
        // y se lo pasa a logística SIN chofer ni día (entra a la Bandeja).
        // A su nombre, pendiente, y solo para un cliente real.
        (
          isSupervisor()
          && request.resource.data.status == 'pendiente'
          && request.resource.data.get('driverId', null) == null
          && request.resource.data.origenSupervisor.uid == request.auth.uid
          && get(/databases/$(database)/documents/users/$(request.resource.data.clientId)).data.rol == 'cliente'
        )
      );

      // Lectura: el cliente dueño, el chofer asignado, operador, comercial, facturación,
      // gerente general o el encargado de heladeras (necesita ver entregas de hielo
      // para el ranking de consumo por cliente).
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.clientId ||
        request.auth.token.email == resource.data.driverId ||
        isOperator() ||
        isManager() ||
        isFacturacion() ||
        isGerenteGeneral() ||
        myRole() == 'heladeras_encargado' ||
        // Supervisor: historial de pedidos en la ficha del cliente (2026-09-07).
        isSupervisor()
      );

      // Actualización del chofer asignado: solo para marcar la entrega. Nunca
      // precio/productos/cliente/chofer (antes esta rama no tenía ningún
      // límite de campos y compartía allow con isOperator()/isGerenteComercial()).
      // myEstado() == 'activo': un chofer dado de baja con sesión todavía
      // vigente no debe poder seguir marcando entregas de pedidos ya
      // asignados (antes solo la UI se lo impedía, no las reglas).
      allow update: if request.auth != null &&
        request.auth.token.email == resource.data.driverId &&
        myEstado() == 'activo' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'productosEntregados', 'entregaParcial', 'notaEntrega', 'updatedAt', 'historialAcciones']);

      // Chofer marca "no entregado": reprograma su propio pedido asignado al
      // día siguiente y lo libera (vuelve a bandeja sin chofer, para que
      // planificación lo reasigne) — mismo mecanismo que ya usa staff desde
      // /admin/monitoreo (rescheduleOrder), acotado a su propio pedido y sin
      // poder tocar nada más ni reasignarse a otro chofer.
      allow update: if request.auth != null &&
        request.auth.token.email == resource.data.driverId &&
        myEstado() == 'activo' &&
        resource.data.status in ['pendiente', 'confirmado', 'en_camino'] &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reprogramado', 'fechaOriginal', 'motivoReprogramacion', 'choferOriginal', 'driverId', 'date', 'avisoCercaEnviado', 'updatedAt']) &&
        request.resource.data.status == 'pendiente' &&
        request.resource.data.reprogramado == true &&
        request.resource.data.driverId == null;

      // Actualización por operador o gerente_comercial: gestión operativa
      // completa del pedido (estado, chofer, reprogramación, edición de
      // productos/fecha desde el kanban), pero nunca los campos de identidad
      // del cliente ni los de auditoría de creación.
      allow update: if request.auth != null && (isOperator() || isGerenteComercial())
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'status', 'updatedAt', 'motivoCancelacion', 'historialAcciones',
               'driverId', 'vuelta', 'clientAddress', 'date', 'reprogramado', 'fechaOriginal',
               'motivoReprogramacion', 'choferOriginal', 'reasignado',
               'motivoReasignacion', 'products', 'horaEntrega', 'notes', 'numeroOC',
               'avisoCercaEnviado'
             ]);

      // gerente_general: reprogramar/reasignar desde /admin/monitoreo.
      // Solo los campos de esas dos acciones; no puede reescribir el pedido.
      allow update: if request.auth != null && isGerenteGeneral()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'date', 'driverId', 'status', 'updatedAt',
               'reprogramado', 'fechaOriginal', 'motivoReprogramacion',
               'reasignado', 'choferOriginal', 'motivoReasignacion',
               'avisoCercaEnviado'
             ]);

      // Borrado: solo operadores (herramienta de limpieza). El chofer no borra.
      allow delete: if request.auth != null && isOperator();

      // El cliente puede cancelar su propio pedido solo si está pendiente, y esa
      // operación solo puede tocar el estado/motivo (no reescribir el pedido).
      allow update: if request.auth != null && !esEscrituraImpersonada() &&
        request.auth.uid == resource.data.clientId &&
        resource.data.status == 'pendiente' &&
        request.resource.data.status == 'cancelado' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'motivoCancelacion', 'updatedAt']);
    }

    // ── Configuración (catálogo, zonas prohibidas, etc.) ──────────────────────
    match /config/{docId} {
      // El catálogo lo necesita el cliente para armar el pedido; motivosReparacion
      // y ticketServicioCounter los necesita para autogestionar un pedido de
      // service desde "Mis heladeras" (crearTicket lee el contador antes de
      // incrementarlo); el resto (zonas prohibidas, etc.) es operativo → solo staff.
      // Documentos de facturación electrónica: NADIE los escribe desde un
      // cliente, solo el Admin SDK (y la consola de Firebase, que lo usa).
      //   config/arca                → si alguien tocara `preciosIncluyenIva`
      //                                cambiaría el total facturado un 21%.
      //   config/arcaNumeracion_*    → contadores correlativos: editarlos a mano
      //                                rompe la correlatividad y ARCA rechaza
      //                                todo lo que venga después.
      // Las reglas de Firestore son permisivas por unión: una regla más
      // específica no puede RESTRINGIR lo que otra concede, así que la
      // excepción tiene que estar acá adentro y no en un match aparte.
      // Cubre config/arca, config/arcaNumeracion_* y config/arcaPadronIIBB: todo
      // lo que toca la emisión de comprobantes lo escribe solo el Admin SDK.
      // Falsear la vigencia del padrón, por ejemplo, haría facturar con
      // alícuotas viejas sin que nada avise.
      function esConfigArca() {
        return docId.matches('arca.*');
      }

      allow read: if esNoAnonimo()
        && (docId == 'catalogo' || docId == 'motivosReparacion' || docId == 'ticketServicioCounter' || isStaff());
      allow write: if request.auth != null && isOperator() && !esConfigArca();
      // Bridge de Tango: necesita leer config/tango (interruptor
      // produccionEnabled) y escribir su propio heartbeat, nada más.
      allow read: if request.auth != null && isTangoBridge() && docId == 'tango';
      // + comprobantesSync: resumen de la última corrida del lector de comprobantes (2026-09-10).
      allow update: if request.auth != null && isTangoBridge() && docId == 'tango'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bridgeListenerLastSeen', 'comprobantesSync']);
      // Comercial y gerente_comercial pueden editar el catálogo (config/catalogo).
      allow write: if request.auth != null && docId == 'catalogo' && isManager();
      // Catálogos de motivos/tipos de reparación, pasos de taller y contador
      // de remitos/comodatos: solo el módulo heladeras.
      allow write: if request.auth != null
        && docId in ['motivosReparacion', 'tiposReparacion', 'motivosIngreso', 'pasosTaller', 'movimientoHeladeraCounter', 'ticketServicioCounter']
        && isHeladerasFullAccess();
      // Cliente: incrementa en 1 el contador de tickets al autogestionar su
      // propio pedido de service (mismo contador que usa Toma de service) —
      // nada más que ese doc, ese campo, ese delta.
      allow update: if request.auth != null && isCliente() && docId == 'ticketServicioCounter'
        && request.resource.data.next == resource.data.next + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['next']);
      // Supervisor (2026-09-07): mismo delta de 1 en el contador de tickets
      // (pide service desde la ficha) y en el de comodatos (firma la
      // renovación en el celular).
      allow update: if request.auth != null && isSupervisor()
        && docId in ['ticketServicioCounter', 'movimientoHeladeraCounter']
        && request.resource.data.next == resource.data.next + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['next']);

      // Contador de remitos de carga por planta (cargaCounter_torcuato /
      // cargaCounter_merlo) — caja solo toca el de SU planta, y en updates
      // solo puede avanzar `next` (la transacción de crearRemitoCarga crea el
      // doc en el primer uso con next >= 2: número emitido + 1).
      // Mismo esquema para el contador de rendiciones (cierre de caja por
      // persona, rendicionCounter_{planta}) y el de entregas a tesorería
      // (entregaCounter_{planta}), 2026-09-09.
      allow create: if request.auth != null
        && docId.matches('(cargaCounter|rendicionCounter|entregaCounter)_(torcuato|merlo)') && isCajaDe(docId.split('_')[1])
        && request.resource.data.next is int && request.resource.data.next > 1;
      allow update: if request.auth != null
        && docId.matches('(cargaCounter|rendicionCounter|entregaCounter)_(torcuato|merlo)') && isCajaDe(docId.split('_')[1])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['next'])
        && request.resource.data.next > resource.data.next;
      // Contador del remito R de carga (remitoCargaCounter, talonario 00025,
      // 2026-09-10): lo inicializa el super_admin desde Ajustes (regla de
      // operador de arriba) y cualquier caja lo avanza, solo hacia adelante.
      allow update: if request.auth != null
        && docId == 'remitoCargaCounter' && isCaja()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['next'])
        && request.resource.data.next > resource.data.next;
      // Contador de LIQUIDACIONES por persona (liquidacionCounter_{serie},
      // 2026-09-09): cualquier caja lo avanza (un repartidor puede liquidar en
      // cualquier planta), solo hacia adelante.
      allow create: if request.auth != null
        && docId.matches('liquidacionCounter_[A-Za-z0-9-]+') && isCaja()
        && request.resource.data.next is int && request.resource.data.next > 1;
      allow update: if request.auth != null
        && docId.matches('liquidacionCounter_[A-Za-z0-9-]+') && isCaja()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['next'])
        && request.resource.data.next > resource.data.next;

      // Contador de TURNOS de ventanilla por planta (se resetea por día:
      // { fecha, next }) — solo caja de esa planta, dentro de la transacción
      // de crearVentaVentanilla.
      allow create, update: if request.auth != null
        && docId in ['turnoVentanilla_torcuato', 'turnoVentanilla_merlo'] && isCajaDe(docId.split('_')[1])
        && request.resource.data.fecha is string
        && request.resource.data.next is int && request.resource.data.next > 1;

      // Contadores de correlativo de producción (uno por planta:
      // produccionCounter_torcuato / produccionCounter_merlo). Alta inicial
      // (número de arranque real) solo por super_admin/produccion_encargado y
      // solo si el doc todavía no existe — OJO: esto no es una garantía dura,
      // isOperator() arriba ya le da a super_admin/logistica write total sobre
      // config/*, así que en la práctica la protección "no pisar un contador
      // ya inicializado" depende de que inicializarContador() solo se llame
      // desde el botón dedicado, no de las reglas.
      allow create: if request.auth != null && docId.matches('produccionCounter_.*')
        && isProduccionEncargado();
      // Reserva de lote: el operario de producción solo puede incrementar
      // `next`, nunca retroceder ni tocar otro campo.
      allow update: if request.auth != null && docId.matches('produccionCounter_.*')
        && isProduccion()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['next'])
        && request.resource.data.next > resource.data.next;

      // Contador de recibos de cobranza de supervisor (único, global — los
      // supervisores no están fijos a una planta). Alta inicial solo por
      // super_admin (isOperator() write total, arriba); el supervisor solo
      // puede avanzar `next` al reservar un lote — mismo patrón que producción.
      allow update: if request.auth != null && docId == 'reciboSupervisorCounter'
        && (isSupervisor() || isCaja() || isChofer())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['next'])
        && request.resource.data.next > resource.data.next;

      // Numeración de los comprobantes internos de la venta
      // (config/numeracionInterna_remito, _facturaX = { next, puntoVenta }).
      // Alta inicial solo por super_admin; quien vende solo avanza `next` al
      // reservar un lote, nunca toca el punto de venta ni retrocede. Vende el
      // chofer, el supervisor (depósito propio, 2026-09-06) y caja en
      // ventanilla (factura X de promo, 2026-09-08) — sin este permiso la
      // venta salía "sin número" y Tango la rechazaba.
      allow update: if request.auth != null && docId.matches('numeracionInterna_.*')
        && (isChofer() || isSupervisor() || isCaja())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['next'])
        && request.resource.data.next > resource.data.next;
    }

    // ── Emails de notificación admin ──────────────────────────────────────────
    // Contiene emails de staff, modoTest y testEmail → nunca legible por el
    // cliente. Los triggers de email lo leen server-side (admin SDK), no la UI.
    // Escritura: solo operadores.
    match /configuracion/{docId} {
      allow read:  if request.auth != null && isStaff();
      allow write: if request.auth != null && isOperator();
    }

    // Las listas de precios propias de la app (listas-precios) y su historial
    // (historialPrecios) se eliminaron el 2026-09-03: los precios vienen de
    // Tango (preciosTango/* más abajo y users.preciosTango). Sin match, nadie
    // puede leer ni escribir esas colecciones.

    // ── Catálogo de productos ─────────────────────────────────────────────────
    match /catalogo/{productoId} {
      allow read:  if esNoAnonimo();
      allow write: if request.auth != null && isOperator();
    }

    // ── Visitas programadas ───────────────────────────────────────────────────
    match /programas-visita/{id} {
      allow read:  if esNoAnonimo();
      allow write: if request.auth != null && isOperator();
    }
    match /visitas-puntuales/{id} {
      allow read:  if esNoAnonimo();
      allow write: if request.auth != null && isOperator();
      // Supervisor en la calle (2026-09-07): pide una visita sin chofer y a su
      // nombre; logística la asigna desde Visitas.
      allow create: if request.auth != null && isSupervisor()
        && request.resource.data.get('driverId', null) == null
        && request.resource.data.status == 'pendiente'
        && request.resource.data.origenSupervisor.uid == request.auth.uid;
      // Chofer puede actualizar sus propias visitas, solo el estado/notas/orderId
      // (no reasignarse ni reescribir la visita).
      allow update: if request.auth != null
        && myRole() == 'chofer'
        && resource.data.driverId == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'notas', 'orderId']);
    }

    // ── Flota de vehículos ────────────────────────────────────────────────────
    match /flota/{camionId} {
      allow read:  if esNoAnonimo();
      allow write: if request.auth != null && isOperator();
    }

    // ── Heladeras (taller: pipeline configurable — ver config/pasosTaller) ──
    match /heladeras/{heladeraId} {
      // Lectura: personal de taller, acceso completo del módulo (encargado/super_admin/
      // gerente_comercial), comercial en solo-lectura (necesita ver qué cliente tiene
      // qué heladera y su ficha para la pantalla de asignación — sin poder escribir),
      // técnico (escanea el QR de la etiqueta en el equipo del cliente) y gerente_general
      // en solo-lectura (panorama cross-sector del panel de directores, /gerente — nunca
      // opera el módulo, solo mira el resumen).
      allow read:   if request.auth != null && (isHeladeras() || isHeladerasFullAccess() || myRole() == 'comercial' || isTecnico() || myRole() == 'gerente_general');
      // Cliente: solo lee SU PROPIA heladera asignada (comodato vigente) —
      // pantalla "Mis heladeras".
      allow read:   if request.auth != null && isCliente() && resource.data.get('clienteAsignadoId', null) == request.auth.uid;
      // Supervisor en la calle (2026-09-07): ve las heladeras de cualquier
      // cliente (ficha del cliente, QR de la etiqueta) para pedir service y
      // firmar el comodato. Solo lectura más las dos ramas de abajo.
      allow read:   if request.auth != null && isSupervisor();
      allow create: if request.auth != null && isHeladerasFullAccess();
      // El encargado, super_admin y gerente_comercial conservan permiso amplio: además
      // de crear y aprobar, usan esta rama para liberarForzado/marcarBaja desde
      // cualquier estado (es la vía de corrección cuando el personal se
      // olvidó de soltar una heladera o el registro quedó inconsistente).
      allow update: if request.auth != null && isHeladerasFullAccess();

      // Personal de sector: NO tiene una rama de "update libre" — solo puede
      // ejecutar las transiciones puntuales de SU paso actual, cada una
      // validada contra el estado actual del documento y el catálogo
      // config/pasosTaller (antes solo se limitaban las claves tocadas, así
      // que cualquiera con acceso a la consola de Firestore podía poner
      // estado:'disponible' o 'baja' sin pasar por el flujo). El paso lo da
      // el catálogo — no hay una rama que permita saltear ni repetir uno.
      allow update: if request.auth != null && puedeAgarrarPasoActual();
      allow update: if request.auth != null && puedeAvanzarPasoActual();
      allow update: if request.auth != null && puedeRechazarPasoActual();

      // Cliente: al autogestionar un pedido de service desde "Mis heladeras"
      // deja una línea en el historial de SU PROPIA heladera — nada más.
      allow update: if request.auth != null && isCliente()
        && resource.data.get('clienteAsignadoId', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['historialAcciones', 'updatedAt']);

      // Supervisor: (a) línea de historial al abrir un ticket de service de
      // una heladera EN COMODATO; (b) renovación del comodato (firma en el
      // celular, renovarComodato): solo los campos de vigencia del contrato,
      // con número nuevo — nunca el estado, el cliente ni el pipeline.
      allow update: if request.auth != null && isSupervisor()
        && resource.data.estado == 'en_comodato'
        && resource.data.get('clienteAsignadoId', null) != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['historialAcciones', 'updatedAt']);
      allow update: if request.auth != null && isSupervisor()
        && resource.data.estado == 'en_comodato'
        && resource.data.get('clienteAsignadoId', null) != null
        && request.resource.data.comodatoNumero is int
        && request.resource.data.comodatoFirmadoEl is timestamp
        && request.resource.data.comodatoVenceEl is timestamp
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['comodatoNumero', 'comodatoFirmadoEl', 'comodatoVenceEl', 'comodatoAvisoEnviado', 'historialAcciones', 'updatedAt']);

      allow delete: if false;
    }

    // ── Asignación de equipos (remitos + comodatos) ────────────────────────
    // Historial append-only de asignaciones/retiros — mismo espíritu que
    // historialPrecios. comercial lo lee (quiere saber qué cliente tiene
    // heladera) pero no puede generar ni tocar movimientos.
    match /asignacionesHeladera/{asignacionId} {
      // Cliente: solo su propio historial de comodatos (asignaciones y
      // retiros) — pantalla "Mis heladeras".
      allow read:   if request.auth != null && (
        isHeladerasFullAccess() || myRole() == 'comercial' ||
        (isCliente() && resource.data.get('clientId', null) == request.auth.uid)
      );
      allow create: if request.auth != null && isHeladerasFullAccess();
      // Supervisor (2026-09-07): solo RENOVACIONES firmadas en el celular, a
      // su nombre — nunca una asignación nueva ni un retiro desde la calle.
      allow create: if request.auth != null && isSupervisor()
        && request.resource.data.tipo == 'renovacion'
        && request.resource.data.firmaDataUrl is string
        && request.resource.data.firmaDataUrl.size() > 0
        && request.resource.data.actor.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Tickets de service ──────────────────────────────────────────────────
    match /ticketsServicio/{ticketId} {
      // Lectura: acceso completo del módulo, o el técnico/chofer asignado —
      // solo su propio ticket (Toma/Consulta de service son pantallas de
      // encargado; técnico y chofer solo ven lo que les toca a ellos).
      allow read: if request.auth != null && (
        isHeladerasFullAccess() ||
        (isTecnico() && resource.data.get('asignadoA', null) != null && resource.data.asignadoA.uid == request.auth.uid) ||
        (isChofer()  && resource.data.get('asignadoA', null) != null && resource.data.asignadoA.uid == request.auth.uid) ||
        (isCliente() && resource.data.get('clientId', null) == request.auth.uid) ||
        (isSupervisor() && resource.data.get('creadoPor', null) != null && resource.data.creadoPor.uid == request.auth.uid)
      );
      // Crear, asignar/reasignar, cerrar y anular: solo el módulo heladeras
      // (Toma de service / Consulta de service).
      allow create: if request.auth != null && isHeladerasFullAccess();

      // Cliente: puede autogestionar un pedido de service desde "Mis
      // heladeras" — solo para SU PROPIA heladera (verificado contra el doc
      // en heladeras/), a su propio nombre, recién abierto y sin asignar.
      allow create: if request.auth != null && isCliente()
        && request.resource.data.clientId == request.auth.uid
        && get(/databases/$(database)/documents/heladeras/$(request.resource.data.heladeraId)).data.clienteAsignadoId == request.auth.uid
        && request.resource.data.estado == 'abierto'
        && request.resource.data.get('asignadoA', null) == null;

      // Supervisor en la calle (2026-09-07): abre un ticket desde la ficha
      // del cliente — solo para una heladera que ESE cliente tiene asignada,
      // con origen 'supervisor' (el trigger avisa al encargado) y a su
      // nombre; recién abierto y sin asignar, como el del cliente.
      allow create: if request.auth != null && isSupervisor()
        && request.resource.data.origen == 'supervisor'
        && request.resource.data.creadoPor.uid == request.auth.uid
        && get(/databases/$(database)/documents/heladeras/$(request.resource.data.heladeraId)).data.clienteAsignadoId == request.resource.data.clientId
        && request.resource.data.estado == 'abierto'
        && request.resource.data.get('asignadoA', null) == null;

      allow update: if request.auth != null && isHeladerasFullAccess();

      // Técnico: solo puede registrar el trabajo en SU ticket asignado,
      // mientras siga 'asignado_tecnico' — no puede cerrarlo ni reasignarlo.
      allow update: if request.auth != null && isTecnico()
        && resource.data.get('asignadoA', null) != null
        && resource.data.asignadoA.uid == request.auth.uid
        && resource.data.estado == 'asignado_tecnico'
        && request.resource.data.estado == resource.data.estado
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['tipoReparacionId', 'tipoReparacionNombre', 'trabajosRealizados', 'trabajoRealizado', 'historialAcciones', 'updatedAt']);

      // Chofer: solo puede marcar hecho su propio traslado, sin tipo de
      // reparación (no es un service técnico) y sin cerrar el ticket.
      allow update: if request.auth != null && isChofer()
        && resource.data.get('asignadoA', null) != null
        && resource.data.asignadoA.uid == request.auth.uid
        && resource.data.estado == 'asignado_chofer'
        && request.resource.data.estado == resource.data.estado
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['trabajoRealizado', 'historialAcciones', 'updatedAt']);

      allow delete: if false;
    }

    // ── Preventivos (mantenimiento anual) ──────────────────────────────────
    match /preventivos/{preventivoId} {
      allow read:  if request.auth != null && (isHeladerasFullAccess() || myRole() == 'comercial');
      allow write: if request.auth != null && isHeladerasFullAccess();
    }

    // ── Pañol (stock de repuestos/materiales) ──────────────────────────────
    match /panolArticulos/{articuloId} {
      // El técnico necesita ver qué es lo que le van a entregar/entregaron.
      allow read:  if request.auth != null && (isHeladerasFullAccess() || isTecnico());
      allow write: if request.auth != null && isHeladerasFullAccess();
    }

    match /panolMovimientos/{movimientoId} {
      allow read: if request.auth != null && (
        isHeladerasFullAccess() ||
        (isTecnico() && resource.data.get('destinatario', null) != null && resource.data.destinatario.uid == request.auth.uid)
      );
      allow create: if request.auth != null && isHeladerasFullAccess();
      // Técnico: solo firma su propia entrega para confirmar que la recibió,
      // una sola vez (no puede reescribir una ya confirmada ni tocar otro campo).
      allow update: if request.auth != null && isTecnico()
        && resource.data.get('destinatario', null) != null
        && resource.data.destinatario.uid == request.auth.uid
        && resource.data.confirmado == false
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['confirmado', 'firmaDataUrl', 'confirmadoAt']);
      allow delete: if false;
    }

    // ── Producción de hielo: pallets cargados en planta ────────────────────
    // Inmutable: un pallet cargado equivale a un comprobante ya emitido (el
    // ticket físico ya está pegado al pallet) — nunca se edita ni se borra.
    match /produccionPallets/{palletId} {
      allow read: if request.auth != null
        && (isProduccion() || isManager() || isGerenteGeneral() || myRole() == 'logistica'
            || myRole() == 'produccion_encargado');

      allow create: if request.auth != null && isProduccion()
        && request.resource.data.plantaId == myPlanta()
        && request.resource.data.operador.uid == request.auth.uid
        && request.resource.data.productoId in [
             'bolsas_10kg_rolito', 'bolsas_3kg_rolito', 'bolsas_2kg_rolito',
             'picado_10kg', 'escama_10kg', 'barras_hielo', 'rembolsado_cementera_10kg'
           ]
        && request.resource.data.numero is int && request.resource.data.numero > 0
        && request.resource.data.unidades is int && request.resource.data.unidades > 0
        && request.resource.data.codigo is string;

      allow update, delete: if false;
    }

    // ── Producción de hielo: parte de máquinas del maquinista ──────────────
    // Un doc por planta/día/turno (`{plantaId}_{fecha}_{turno}`). Lo carga el
    // maquinista (rol 'produccion_hielo', subrol en el perfil — las reglas no
    // distinguen subrol: cualquier operario de la planta puede escribir, la UI
    // decide qué pantalla ve cada puesto). El encargado puede corregir.
    match /partesMaquinas/{parteId} {
      allow read: if request.auth != null
        && (isProduccion() || isManager() || isGerenteGeneral() || myRole() == 'logistica'
            || myRole() == 'produccion_encargado');

      // El operario/maquinista solo crea y edita partes de SU planta, y nunca
      // puede reasignar el doc a otra planta.
      allow create: if request.auth != null && isProduccion()
        && request.resource.data.plantaId == myPlanta()
        && request.resource.data.turno in ['manana', 'tarde', 'noche']
        && request.resource.data.fecha is string;
      allow update: if request.auth != null && isProduccion()
        && resource.data.plantaId == myPlanta()
        && request.resource.data.plantaId == resource.data.plantaId;

      // Encargado (y super_admin) pueden crear/corregir partes de cualquier planta.
      allow create, update: if request.auth != null && isProduccionEncargado();

      allow delete: if false;
    }

    // ── Ventas desde el camión (reparto a demanda) ─────────────────────────
    // El chofer registra la venta/entrega que hace desde su camión (descarga
    // del depósito-camión → remito en Tango). Inmutable tras crearse: el número
    // de remito lo escribe de vuelta la Cloud Function onOutboxConfirmado
    // (Admin SDK, bypassa estas reglas). Ver docs/tango/INTEGRACION.md.
    match /ventasCamion/{ventaId} {
      // isCaja: la liquidación del repartidor suma las ventas del día.
      allow read: if request.auth != null
        && (isOperator() || isManager() || isGerenteGeneral() || isCaja() || isTesoreria()
            // isSupervisor: 'Reparto en vivo' (liquidación en vivo de todos los camiones, 2026-09-05)
            || isSupervisor()
            // isFacturacion: Comprobantes de clientes regenera la factura de una
            // venta de camión para mandársela al cliente (2026-09-10).
            || isFacturacion()
            || (isChofer() && resource.data.choferId == request.auth.uid));

      // isSupervisor: los supervisores también entregan (son depósitos en
      // Tango, expedición por depósito 2026-09-06); venden con su propio uid.
      allow create: if request.auth != null && (isChofer() || isSupervisor())
        && request.resource.data.choferId == request.auth.uid
        && request.resource.data.clienteId is string
        && request.resource.data.camionId is string
        && request.resource.data.canal in ['promo', 'contado']
        && request.resource.data.formaPago in ['contado_efectivo', 'contado_transferencia', 'cuenta_corriente']
        && request.resource.data.items is list
        // Los cambios (renglones en $0) viajan aparte de `items` justamente
        // para que no puedan sumar al total ni a lo que se declara a ARCA.
        && (!('cambios' in request.resource.data) || request.resource.data.cambios is list)
        && request.resource.data.total is number;

      // Remito de cuenta corriente anulado por el propio chofer, sin autorización
      // (2026-09-11, decisión de Ariel): solo el campo `anulacion`, solo sobre
      // su venta, solo si salió por remito (sin factura de ARCA), sin anulación
      // previa y con la liquidación de ese día todavía abierta. La oficina lo
      // anula en Tango; el server anota el estado en Tango.
      function remitoCtaCteAnulable() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['anulacion'])
          && !('anulacion' in resource.data)
          && !('factura' in resource.data)
          && resource.data.get('canal', '') == 'contado'
          && resource.data.get('formaPago', '') == 'cuenta_corriente'
          && resource.data.get('comprobanteInterno', {}).get('tipo', '') == 'remito'
          && request.resource.data.anulacion.tipo == 'remito'
          && request.resource.data.anulacion.estado == 'anulada'
          && request.resource.data.anulacion.anuladaPor.uid == request.auth.uid
          && request.resource.data.anulacion.motivo is string
          && request.resource.data.anulacion.fechaVenta is string;
      }
      // Ventana de 60 minutos desde la venta (2026-09-12, decisión de Ariel: sin
      // fricción para corregir en el momento; pasada la hora lo pide a la oficina).
      allow update: if request.auth != null && isChofer()
        && resource.data.choferId == request.auth.uid
        && remitoCtaCteAnulable()
        && !('origen' in request.resource.data.anulacion)
        && request.time.toMillis() - resource.data.fecha.toMillis() <= 60 * 60 * 1000
        && !exists(/databases/$(database)/documents/liquidaciones/$(request.resource.data.anulacion.fechaVenta + '_' + request.auth.uid));
      // Días anteriores (2026-09-11): facturación (o el super_admin) anula el
      // remito de cualquier chofer aunque la liquidación ya esté cerrada; el
      // server le anota la anulación al cierre, que no se reabre.
      allow update: if request.auth != null && (isFacturacion() || isOperator())
        && remitoCtaCteAnulable()
        && request.resource.data.anulacion.get('origen', '') == 'facturacion';

      allow delete: if false;
    }

    // ── Expedición: remitos de carga del camión ────────────────────────────
    // Caja (rol 'caja', fijo por planta) emite el remito con el que muelle
    // carga el camión. Los items nunca se editan tras emitirse (comprobante
    // impreso); las transiciones de estado (entregado/salido/liquidado) llegan
    // en fases siguientes con reglas propias por rol — por ahora update: false.
    match /remitosCarga/{remitoId} {
      allow read: if request.auth != null
        && (isCaja() || isMuelle() || isSeguridad() || isOperator() || isManager() || isGerenteGeneral() || isSupervisor() || isTesoreria()
            || (isChofer() && resource.data.choferId == request.auth.uid));

      allow create: if request.auth != null && isCajaDe(request.resource.data.plantaId)
        && request.resource.data.creadoPor.uid == request.auth.uid
        && request.resource.data.camionId is string
        && request.resource.data.choferId is string
        && request.resource.data.numero is int && request.resource.data.numero > 0
        && request.resource.data.codigo is string
        && request.resource.data.items is list && request.resource.data.items.size() > 0
        && request.resource.data.palletsCarga is int && request.resource.data.palletsCarga >= 0
        // Composición de envases (2026-09-07). Opcional para las tablets con
        // la PWA anterior; cuando viene, tiene que cerrar con palletsCarga.
        && (!('envases' in request.resource.data)
            || (envasesCargaOk(request.resource.data.envases) && palletsCoherentes(request.resource.data)))
        && request.resource.data.estado == 'emitido'
        // COT de ARBA (2026-09-10): caja puede mandar los kilos y la solicitud
        // (destino, remito R, patente, recorrido); el resultado `cot` lo
        // escribe SOLO el server, nunca nace con el doc.
        && !('cot' in request.resource.data)
        && (!('kg' in request.resource.data) || request.resource.data.kg is number)
        && (!('cotSolicitud' in request.resource.data)
            || (request.resource.data.cotSolicitud is map
                && request.resource.data.cotSolicitud.destino is map
                && request.resource.data.cotSolicitud.respaldo is map
                && request.resource.data.cotSolicitud.patente is string))
        // Remito R oficial de la carga numerado por la app (talonario 00025,
        // contador config/remitoCargaCounter en la misma transacción).
        && (!('remitoR' in request.resource.data)
            || (request.resource.data.remitoR is map
                && request.resource.data.remitoR.puntoVenta is int
                && request.resource.data.remitoR.numero is int && request.resource.data.remitoR.numero > 0
                && request.resource.data.remitoR.cai is string));

      // Muelle confirma que entregó la mercadería: solo la transición
      // emitido → entregado, solo en su planta y a su propio nombre. Puede
      // corregir la composición de envases que le dictó a caja (envases +
      // palletsCarga, siempre juntos y coherentes); los items del remito
      // siguen siendo inmutables.
      allow update: if request.auth != null && isMuelleDe(resource.data.plantaId)
        && resource.data.estado == 'emitido'
        && request.resource.data.estado == 'entregado'
        && request.resource.data.entregadoPor.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'entregadoPor', 'envases', 'palletsCarga'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['envases', 'palletsCarga'])
            || (envasesCargaOk(request.resource.data.envases) && palletsCoherentes(request.resource.data)));

      // Muelle asigna/cambia la dársena de carga (tablero de TV) mientras el
      // remito sigue emitido — solo ese campo.
      allow update: if request.auth != null && isMuelleDe(resource.data.plantaId)
        && resource.data.estado == 'emitido'
        && request.resource.data.darsena is int
        && request.resource.data.darsena >= 1 && request.resource.data.darsena <= 20
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['darsena']);

      // Seguridad libera la salida en el portón: solo entregado → salido,
      // solo esos dos campos, solo en su planta y a su propio nombre.
      allow update: if request.auth != null && isSeguridadDe(resource.data.plantaId)
        && resource.data.estado == 'entregado'
        && request.resource.data.estado == 'salido'
        && request.resource.data.salida.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'salida']);

      allow delete: if false;
    }

    // ── Expedición: cambios de producto defectuoso — HISTÓRICO ─────────────
    // Bolsa rota del cliente por una nueva, sin venta ni plata. Hasta
    // 2026-09-02 era una operación aparte y caía acá; hoy el cambio es un
    // renglón en $0 de la venta (ventasCamion.cambios), para que salga en el
    // mismo comprobante que firma el cliente. Solo lectura: la liquidación de
    // los días anteriores a la migración sigue leyendo de acá.
    match /cambiosCamion/{cambioId} {
      allow read: if request.auth != null
        && (isCaja() || isMuelle() || isOperator() || isManager() || isGerenteGeneral() || isSupervisor() || isTesoreria()
            || (isChofer() && resource.data.choferId == request.auth.uid));

      allow write: if false;
    }

    // ── Expedición: descarga del camión (conteo físico de muelle) ──────────
    // El conteo contra el que se liquida el día — inmutable, y solo muelle de
    // la planta puede registrarlo (separación de controles: quien cuenta la
    // mercadería no es quien cierra la plata).
    match /descargasCamion/{descargaId} {
      allow read: if request.auth != null
        && (isCaja() || isMuelle() || isOperator() || isManager() || isGerenteGeneral() || isSupervisor() || isTesoreria()
            || (isChofer() && resource.data.choferId == request.auth.uid));

      allow create: if request.auth != null && isMuelleDe(request.resource.data.plantaId)
        && request.resource.data.registradoPor.uid == request.auth.uid
        && request.resource.data.choferId is string
        && request.resource.data.camionId is string
        && request.resource.data.items is list
        && request.resource.data.bolsasRotas is list
        // Envases que volvieron (desde 2026-09-07), o el formato viejo de
        // pallets completos / parciales / vacíos — LEGACY: solo para tablets
        // con la PWA anterior; sacar cuando todas hayan actualizado.
        && (envasesDescargaOk(request.resource.data.envases)
            || (!('envases' in request.resource.data) && palletsLegacyOk(request.resource.data)));

      function palletsLegacyOk(d) {
        return d.palletsCompletos is int && d.palletsCompletos >= 0
          && d.palletsParciales is int && d.palletsParciales >= 0
          && d.palletsVacios is int && d.palletsVacios >= 0;
      }

      allow update, delete: if false;
    }

    // ── Expedición: venta por ventanilla (caja en mostrador) ───────────────
    // Caja cobra y emite el comprobante; muelle entrega la mercadería contra
    // ese papel (única transición permitida). Los items/importes son
    // inmutables tras emitirse.
    match /ventasVentanilla/{ventaId} {
      // isSupervisor: regenera la factura de una venta de mostrador para
      // compartirla desde la composición de saldos del cliente (2026-09-07).
      // isFacturacion / puedeAutorizarAnulaciones: la bandeja de anulaciones
      // regenera la nota de crédito de la venta (2026-09-09).
      allow read: if request.auth != null
        && (isCaja() || isMuelle() || isSeguridad() || isOperator() || isManager() || isGerenteGeneral() || isSupervisor() || isTesoreria()
            || isFacturacion() || puedeAutorizarAnulaciones());

      allow create: if request.auth != null && isCajaDe(request.resource.data.plantaId)
        && request.resource.data.cajaId == request.auth.uid
        && request.resource.data.canal in ['promo', 'contado']
        && request.resource.data.formaPago in ['contado_efectivo', 'contado_transferencia', 'cuenta_corriente']
        && request.resource.data.items is list && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.estado == 'pendiente_entrega'
        && request.resource.data.turno is int && request.resource.data.turno > 0
        && request.resource.data.turnoEstado == 'en_espera';

      // Muelle maneja la COLA de turnos (preparado / llamado a dársena /
      // ausente) mientras la venta sigue pendiente — solo esos campos, nunca
      // items ni importes.
      allow update: if request.auth != null && isMuelleDe(resource.data.plantaId)
        && resource.data.estado == 'pendiente_entrega'
        && request.resource.data.turnoEstado in ['en_espera', 'preparado', 'llamado', 'ausente']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['turnoEstado', 'darsena', 'llamadoAt']);

      // Muelle confirma la entrega: solo la transición y solo esos campos.
      allow update: if request.auth != null && isMuelleDe(resource.data.plantaId)
        && resource.data.estado == 'pendiente_entrega'
        && request.resource.data.estado == 'entregado'
        && request.resource.data.entregadoPor.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'entregadoPor']);

      // Seguridad estampa la salida del retiro (una sola vez): solo el campo
      // salida, solo sobre ventas ya entregadas de su planta.
      allow update: if request.auth != null && isSeguridadDe(resource.data.plantaId)
        && resource.data.estado == 'entregado'
        && resource.data.get('salida', null) == null
        && request.resource.data.salida.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['salida']);

      allow delete: if false;
    }

    // ── Expedición: tablero público de turnos de ventanilla ────────────────
    // Documento DERIVADO y sanitizado que escribe la Cloud Function
    // publicarTurnosVentanilla (Admin SDK): SOLO números de turno + estado +
    // dársena — sin nombres, productos ni montos, por construcción. Lo lee la
    // página pública /turnos/{planta} con sesión anónima de Firebase (el QR
    // del comprobante). Ver plan del módulo expedición.
    match /turnosPublicos/{plantaId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Expedición: cobranzas (mostrador y calle) ──────────────────────────
    // Pagos de cta. cte. Inmutable. Origen 'caja' lo crea caja en su planta;
    // origen 'cobrador' llega en la Fase 5 con su propia rama.
    match /cobranzas/{cobranzaId} {
      allow read: if request.auth != null
        && (isCaja() || isOperator() || isManager() || isGerenteGeneral() || isFacturacion() || isTesoreria()
            // el chofer/cobrador ve sus propias cobranzas (resumen y liquidación)
            || (isChofer() && resource.data.registradoPor.uid == request.auth.uid)
            // el supervisor ve las suyas y las de calle de los choferes (Reparto en vivo, 2026-09-05)
            || isSupervisor());

      // Las cobranzas simples (cliente + importe, sin factura) se dejaron de crear el
      // 2026-09-05: no llegaban a Tango. Las ya registradas se siguen leyendo.

      // Cobranza completa del supervisor: recibo multi-medio con imputación a
      // facturas de Tango. La triple igualdad total == Σ(imputaciones) ==
      // Σ(medios) no se puede validar acá (las reglas no iteran arrays) — la
      // valida crearCobranzaSupervisor() en el cliente; el doc es inmutable.
      // El super_admin también puede (la pantalla /supervisor/cobrar lo deja
      // entrar; sin esto el guardado se rechazaba en silencio — 2026-09-05).
      // Desde el 2026-09-05 la misma cobranza completa la hacen también caja
      // (origen 'caja', en su planta) y el chofer en la calle (origen 'cobrador').
      allow create: if request.auth != null
        && (((isSupervisor() || myRole() == 'super_admin') && request.resource.data.origen == 'supervisor')
            || (isCajaDe(request.resource.data.plantaId) && request.resource.data.origen == 'caja')
            || (isChofer() && request.resource.data.origen == 'cobrador'))
        && request.resource.data.registradoPor.uid == request.auth.uid
        && request.resource.data.clienteId is string
        && request.resource.data.importe is number && request.resource.data.importe > 0
        && request.resource.data.formaPago == 'mixto'
        // numeroRecibo es opcional (sin numeración hasta conectar Tango,
        // decisión 2026-08-31); si viene, tiene que ser string.
        && (!('numeroRecibo' in request.resource.data) || request.resource.data.numeroRecibo is string)
        && request.resource.data.empresa in ['redonhielo', 'rolito']
        && request.resource.data.imputaciones is list
        // Sin factura imputada solo si algo queda a cuenta (pago adelantado, 2026-09-08).
        && (request.resource.data.imputaciones.size() > 0
            || (request.resource.data.aCuenta is number && request.resource.data.aCuenta > 0))
        && (!('aCuenta' in request.resource.data) || (request.resource.data.aCuenta is number && request.resource.data.aCuenta > 0))
        && request.resource.data.medios is map;

      allow update, delete: if false;
    }

    // ── Facturas de Tango archivadas (2026-09-07) ────────────────────────
    // facturasArchivadas/{empresa}-{clave}: índice del PDF que administración
    // guardó desde Recupero de facturas (Storage facturas/{empresa}/{clave}.pdf)
    // para que el supervisor lo comparta desde la composición de saldos. Solo
    // super_admin y facturación escriben; todo el staff lee; el cliente no.
    match /facturasArchivadas/{facturaId} {
      allow read: if request.auth != null && isStaff();
      allow create, update: if request.auth != null
        && (myRole() == 'super_admin' || isFacturacion())
        && facturaId == request.resource.data.empresa + '-' + request.resource.data.clave
        && request.resource.data.empresa in ['redonhielo', 'rolito']
        && request.resource.data.clave is string
        && request.resource.data.storagePath is string
        && request.resource.data.subidoPor.uid == request.auth.uid;
      allow delete: if false;
    }

    // ── Cobranzas de supervisor: cache de composición de saldos de Tango ──
    // saldosTango/{uid} (uid del cliente): facturas pendientes de cobro con su
    // saldo restante. Lo escribe SOLO el Admin SDK (syncSaldosTango del bridge
    // o la respuesta de tango-consultas). Lectura para quien cobra/gestiona;
    // el cliente NO ve su propio saldo por ahora (decisión de producto).
    match /saldosTango/{clienteUid} {
      allow read: if request.auth != null
        && (isSupervisor() || isCaja() || isChofer() || isOperator() || isManager()
            || isGerenteGeneral() || isFacturacion());
      allow write: if false;
    }

    // ── Índice liviano de clientes para buscar (2026-09-10) ────────────────
    // clientesIndex/{uid}: nombre, CUIT, códigos de Tango, dirección. Lo escribe
    // SOLO el trigger onClienteIndexado (Admin SDK). Lo lee todo el staff (es lo
    // que usan los buscadores de cliente); un cliente no ve la lista de los demás.
    match /clientesIndex/{uid} {
      allow read: if request.auth != null && isStaff();
      allow write: if false;
    }

    // ── Comprobantes de Tango: facturas y remitos de los últimos 13 meses ──
    // (2026-09-09) tangoComprobantes/{empresa}_{codigo} es el índice liviano por
    // código de cliente (facturas/NC/ND con estado y sus remitos; remitos con
    // estado) y tangoComprobanteDetalle/{empresa}_{tipo}_{numero} el detalle
    // para regenerar el PDF (renglones, CAE, cliente, CAI del talonario). Los
    // escribe el lector de la VM (scripts/tango/bridge-sync-comprobantes.mjs)
    // con el usuario bridge, leyendo SQL Server; nadie más escribe. Lectura
    // para quien cobra/gestiona, igual que saldosTango (+ tesorería).
    function leeComprobantesTango() {
      return isSupervisor() || isCaja() || isChofer() || isOperator() || isManager()
        || isGerenteGeneral() || isFacturacion() || isTesoreria();
    }
    match /tangoComprobantes/{docId} {
      allow read: if request.auth != null && leeComprobantesTango();
      allow create, update: if request.auth != null && isTangoBridge();
      allow delete: if false;
    }
    match /tangoComprobanteDetalle/{docId} {
      allow read: if request.auth != null && leeComprobantesTango();
      allow create, update: if request.auth != null && isTangoBridge();
      allow delete: if false;
    }

    // ── Envíos de comprobantes por mail (2026-09-10) ──────────────────────
    // Lo escribe SOLO la Cloud Function enviarComprobantePorMail (Admin SDK):
    // quién mandó qué comprobante a qué mail y cuándo. Lo lee quien gestiona.
    match /enviosComprobantes/{envioId} {
      allow read: if request.auth != null
        && (isOperator() || isManager() || isGerenteGeneral() || isFacturacion() || isTesoreria()
            || resource.data.enviadoPor.uid == request.auth.uid);
      allow write: if false;
    }

    // ── Precios y listas de Tango (Tango es la fuente maestra) ──────────────
    // preciosTango/{empresa} lo escribe la Cloud Function syncPreciosTango
    // (Admin SDK). Lo leen los que venden o miran precios: choferes (venta en
    // la calle), caja (ventanilla), comercial/gerencia/facturación y
    // logística. Los clientes NO: verían las listas de todos los demás.
    match /preciosTango/{empresa} {
      allow read: if request.auth != null
        && (isChofer() || isCaja() || isOperator() || isManager()
            || isGerenteGeneral() || isFacturacion() || isSupervisor());
      allow write: if false;
    }

    // ── Cola inversa de consultas a Tango (refresh on-demand de saldos) ────
    // El supervisor crea un doc pidiendo el saldo fresco de UN cliente; el
    // bridge (isTangoBridge()) lo responde escribiendo SOLO los campos de
    // estado/resultado — nunca puede cambiar qué se preguntó ni por quién.
    // El resultado llega al cache saldosTango vía la Function
    // onConsultaRespondida (Admin SDK), no directo del bridge.
    match /tango-consultas/{consultaId} {
      allow read: if request.auth != null
        && (isTangoBridge() || isOperator()
            || resource.data.solicitadoPor.uid == request.auth.uid);

      allow create: if request.auth != null && (isSupervisor() || isCaja() || isChofer() || myRole() == 'super_admin')
        && request.resource.data.tipo == 'saldoCliente'
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.solicitadoPor.uid == request.auth.uid
        && request.resource.data.clienteUid is string
        && request.resource.data.idGva14 is number
        // Una consulta = una empresa (2026-09-06: la pantalla de cobro dispara
        // una por empresa en la que el cliente está vinculado).
        && request.resource.data.empresa in ['redonhielo', 'rolito']
        && (!('idsGva14' in request.resource.data) || request.resource.data.idsGva14 is list);

      // Refrescar los comprobantes de Tango (facturas/remitos) de un cliente a pedido
      // (2026-09-10): la ficha manda los códigos del cliente en una empresa; el bridge
      // corre el lector solo para esos códigos y responde por el mismo doc.
      allow create: if request.auth != null
        && (isSupervisor() || isCaja() || isChofer() || isOperator() || isFacturacion() || isTesoreria())
        && request.resource.data.tipo == 'sincronizarComprobantes'
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.solicitadoPor.uid == request.auth.uid
        && request.resource.data.empresa in ['redonhielo', 'rolito']
        && request.resource.data.codigos is list && request.resource.data.codigos.size() >= 1 && request.resource.data.codigos.size() <= 50
        && (!('clienteUid' in request.resource.data) || request.resource.data.clienteUid is string);

      allow update: if request.auth != null && isTangoBridge()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'resultado', 'ultimoError', 'actualizadoEn']);

      allow delete: if false;
    }

    // ── Expedición: liquidación del repartidor (cierre del día, por caja) ──
    // ID determinístico {fecha}_{choferId} + create-only: un segundo cierre
    // del mismo día falla en vez de pisar el snapshot.
    match /liquidaciones/{liquidacionId} {
      allow read: if request.auth != null
        // El chofer lee la suya por ID (el create exige id == fecha_choferId):
        // así puede suscribirse aunque todavía no esté cerrada (sin doc no hay
        // resource.data que comparar).
        && (isCaja() || isOperator() || isManager() || isGerenteGeneral() || isSupervisor() || isTesoreria()
            || (isChofer() && liquidacionId.split('_')[1] == request.auth.uid));

      allow create: if request.auth != null && isCajaDe(request.resource.data.plantaId)
        && request.resource.data.cerradaPor.uid == request.auth.uid
        && request.resource.data.choferId is string
        && request.resource.data.fecha is string
        && liquidacionId == request.resource.data.fecha + '_' + request.resource.data.choferId
        && request.resource.data.productos is list
        && request.resource.data.efectivoARendir is number
        && request.resource.data.efectivoRecibido is number
        // Desde 2026-09-09: número por persona, firma de las DOS partes
        // (repartidor y cajero que recibe), valores en papel tildados, y nace
        // sin entrega a tesorería.
        && request.resource.data.numero is int && request.resource.data.numero > 0
        && request.resource.data.codigo is string
        && request.resource.data.firmaRepartidor is string && request.resource.data.firmaRepartidor.size() > 0
        && request.resource.data.firmaRecibe is string && request.resource.data.firmaRecibe.size() > 0
        && request.resource.data.cheques is list
        && request.resource.data.retenciones is list
        && request.resource.data.entregaId == null
        // Cuadre de envases (desde 2026-09-07); los cierres viejos traen `pallets`.
        && (!('envases' in request.resource.data)
            || (request.resource.data.envases is map
                && request.resource.data.envases.salieron is map
                && request.resource.data.envases.volvieron is map
                && request.resource.data.envases.diferencia is map
                && racksOk(request.resource.data.envases.racksFaltantes)));

      // Entrega a tesorería (2026-09-09): caja de la planta marca null → id, una vez.
      allow update: if request.auth != null && isCajaDe(resource.data.plantaId)
        && resource.data.entregaId == null
        && request.resource.data.entregaId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entregaId']);
      allow delete: if false;
    }

    // ── Rendiciones: cierre de caja por persona y día (2026-09-09) ────────
    // Hoy solo tipo 'mostrador' (usuario de ventanilla). Inmutable salvo:
    // `validacion` (tesorería la revisa, una sola vez) y `entregaId` (la
    // entrega a tesorería que la incluye, fase siguiente; solo operador).
    match /rendiciones/{rendicionId} {
      allow read: if request.auth != null
        && (isCaja() || isOperator() || isManager() || isGerenteGeneral() || isTesoreria() || isSupervisor()
            || (isChofer() && resource.data.sujetoId == request.auth.uid));

      allow create: if request.auth != null && isCajaDe(request.resource.data.plantaId)
        && request.resource.data.tipo == 'mostrador'
        && request.resource.data.sujetoId == request.auth.uid
        && request.resource.data.cerradaPor.uid == request.auth.uid
        && request.resource.data.fecha is string
        && rendicionId == request.resource.data.fecha + '_' + request.resource.data.sujetoId
        && request.resource.data.numero is int && request.resource.data.numero > 0
        && request.resource.data.codigo is string
        && request.resource.data.efectivoARendir is number
        && request.resource.data.efectivoContado is number
        && request.resource.data.diferenciaEfectivo is number
        && request.resource.data.firma is string && request.resource.data.firma.size() > 0
        && request.resource.data.ventasIds is list
        && request.resource.data.cobranzasIds is list
        && request.resource.data.validacion == null
        && request.resource.data.entregaId == null;

      // Tesorería valida (null → map con su uid), una sola vez y nada más.
      allow update: if request.auth != null && (isTesoreria() || isOperator())
        && resource.data.validacion == null
        && request.resource.data.validacion is map
        && request.resource.data.validacion.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['validacion']);
      // Entrega a tesorería: caja de la planta (arma la entrega) o el operador, null → id.
      allow update: if request.auth != null && (isOperator() || isCajaDe(resource.data.plantaId))
        && resource.data.entregaId == null
        && request.resource.data.entregaId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entregaId']);

      allow delete: if false;
    }

    // ── Entregas de caja a tesorería (2026-09-09) ─────────────────────────
    // Caja de la planta la crea (firmada, con lo que manda) y la transacción
    // marca entregaId en cada liquidación/cierre incluido. Tesorería (o el
    // operador) la confirma una sola vez: entregada → confirmada con su uid,
    // firma, efectivo contado y los mismos valores tildados. Nadie borra.
    match /entregasTesoreria/{entregaId} {
      allow read: if request.auth != null
        && (isCaja() || isTesoreria() || isOperator() || isManager() || isGerenteGeneral());

      allow create: if request.auth != null && isCajaDe(request.resource.data.plantaId)
        && request.resource.data.entregadoPor.uid == request.auth.uid
        && request.resource.data.estado == 'entregada'
        && request.resource.data.destino == 'tesoreria'
        && request.resource.data.fecha is string
        && request.resource.data.numero is int && request.resource.data.numero > 0
        && request.resource.data.codigo is string
        && entregaId == request.resource.data.fecha + '_' + request.resource.data.plantaId + '_' + string(request.resource.data.numero)
        && request.resource.data.liquidacionIds is list
        && request.resource.data.rendicionIds is list
        && request.resource.data.cheques is list
        && request.resource.data.retenciones is list
        && request.resource.data.efectivoEntregado is number
        && request.resource.data.firmaEntrega is string && request.resource.data.firmaEntrega.size() > 0
        && request.resource.data.recibidoPor == null;

      allow update: if request.auth != null && (isTesoreria() || isOperator())
        && resource.data.estado == 'entregada'
        && request.resource.data.estado == 'confirmada'
        && request.resource.data.recibidoPor is map
        && request.resource.data.recibidoPor.uid == request.auth.uid
        && request.resource.data.firmaRecibe is string && request.resource.data.firmaRecibe.size() > 0
        && request.resource.data.efectivoContado is number
        && request.resource.data.cheques is list && request.resource.data.cheques.size() == resource.data.cheques.size()
        && request.resource.data.retenciones is list && request.resource.data.retenciones.size() == resource.data.retenciones.size()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['estado', 'recibidoPor', 'firmaRecibe', 'firmanteRecibe', 'efectivoContado', 'diferenciaEfectivo',
              'diferencia', 'valoresFaltantes', 'confirmadaEn', 'cheques', 'retenciones']);

      allow delete: if false;
    }

    // ── Anulación de facturas de ventanilla con nota de crédito (2026-09-09) ──
    // El cajero pide (create, id = ventaId, sobre SU venta facturada), un
    // usuario con el permiso individual aprueba o rechaza (una vez, solo esos
    // campos, nunca su propia solicitud). El resultado de ARCA (emitida/error,
    // notaCredito) lo escribe el server. Nadie borra.
    match /anulacionesVentanilla/{anulacionId} {
      function ventaDeLaSolicitud() {
        return get(/databases/$(database)/documents/ventasVentanilla/$(anulacionId)).data;
      }
      function facturaEmitidaYSinAnulacion(v) {
        // Facturada por ARCA (o promo con factura X numerada, 2026-09-11) y sin
        // una anulación en curso o hecha.
        let a = v.get('anulacion', {});
        return (v.get('factura', {}).get('estado', '') == 'emitida'
                || (v.get('canal', '') == 'promo' && v.get('comprobanteInterno', {}).get('numero', 0) > 0))
          && (a.get('estado', 'rechazada') in ['rechazada', 'error']);
      }
      function ventaAnulable() {
        // Ventanilla: del propio cajero.
        let v = ventaDeLaSolicitud();
        return v.cajaId == request.auth.uid && facturaEmitidaYSinAnulacion(v);
      }
      // Factura del camión (2026-09-11): la pide caja desde la liquidación del
      // chofer mientras NO esté cerrada (liquidaciones/{fecha}_{chofer}); la
      // solicitud lleva al chofer y la fecha para que la bandeja lo muestre.
      function ventaCamionAnulable() {
        let d = request.resource.data;
        let v = get(/databases/$(database)/documents/ventasCamion/$(anulacionId)).data;
        return facturaEmitidaYSinAnulacion(v)
          && d.choferId == v.choferId
          && d.fechaVenta is string
          && !exists(/databases/$(database)/documents/liquidaciones/$(d.fechaVenta + '_' + v.choferId));
      }

      allow read: if request.auth != null
        && (isCaja() || isTesoreria() || isOperator() || isManager() || isGerenteGeneral() || isFacturacion()
            || puedeAutorizarAnulaciones());

      // Días anteriores (2026-09-11, decisión de Ariel): la pide FACTURACIÓN (o
      // el super_admin) desde Comprobantes de clientes, sobre cualquier venta
      // facturada, aunque la liquidación o la caja de ese día ya estén
      // cerradas. El cierre no se reabre: el server le anota la anulación.
      function ventaDeDiaCerradoAnulable() {
        let d = request.resource.data;
        let col = d.get('coleccion', '');
        let v = get(/databases/$(database)/documents/$(col)/$(anulacionId)).data;
        return col in ['ventasVentanilla', 'ventasCamion']
          && facturaEmitidaYSinAnulacion(v)
          && d.fechaVenta is string
          && (col == 'ventasVentanilla' || d.choferId == v.choferId);
      }
      function solicitudBienFormada() {
        return request.resource.data.cajaId == request.auth.uid
          && request.resource.data.solicitadoPor.uid == request.auth.uid
          && request.resource.data.ventaId == anulacionId
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.resueltaPor == null
          && request.resource.data.motivo is string;
      }

      allow create: if request.auth != null && isCajaDe(request.resource.data.plantaId)
        && solicitudBienFormada()
        && !('origen' in request.resource.data)
        && (
          (request.resource.data.get('coleccion', 'ventasVentanilla') == 'ventasVentanilla' && ventaAnulable())
          || (request.resource.data.get('coleccion', '') == 'ventasCamion' && ventaCamionAnulable())
        );
      allow create: if request.auth != null && (isFacturacion() || isOperator())
        && solicitudBienFormada()
        && request.resource.data.get('origen', '') == 'facturacion'
        && request.resource.data.plantaId in ['torcuato', 'merlo']
        && ventaDeDiaCerradoAnulable();

      allow update: if request.auth != null && puedeAutorizarAnulaciones()
        && resource.data.estado in ['pendiente', 'error']
        && request.resource.data.estado in ['aprobada', 'rechazada']
        && request.resource.data.resueltaPor is map
        && request.resource.data.resueltaPor.uid == request.auth.uid
        && resource.data.solicitadoPor.uid != request.auth.uid
        && (request.resource.data.estado == 'aprobada'
            || (request.resource.data.notaResolucion is string && request.resource.data.notaResolucion.size() > 0))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'resueltaPor', 'resueltaEn', 'notaResolucion']);

      allow delete: if false;
    }

    // ── Cola de salida hacia Tango (app → Tango, tiempo real) ──────────────
    // Un doc por evento a informar a Tango (hoy solo producción de hielo,
    // pensado genérico para futuros casos). Solo lo crea un Cloud Function
    // trigger (Admin SDK, bypassa estas reglas). El bridge en la VM de Tango
    // (isTangoBridge()) lo escucha en tiempo real y solo puede tocar los
    // campos de estado del procesamiento, nunca el payload ni el origen — así
    // un bridge comprometido no puede falsificar qué se le mandó a Tango.
    // Ver docs/tango/INTEGRACION.md §7.
    match /tango-outbox/{docId} {
      allow read: if request.auth != null && (isTangoBridge() || isOperator());
      allow update: if request.auth != null && isTangoBridge()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'intentos', 'ultimoError', 'actualizadoEn', 'resultado']);
      allow create, delete: if false;
    }

    // ── Depósitos de Tango (expedición por depósito, 2026-09-06) ───────────
    // depositosTango/{codigo}: catálogo que baja la sync (Admin SDK) más los
    // campos editables desde Ajustes (tipo, activo, usuario vinculado). Lo lee
    // todo el staff (caja arma la carga, muelle la descarga, el chofer y el
    // supervisor necesitan saber su depósito al vender/cobrar).
    match /depositosTango/{codigo} {
      allow read: if request.auth != null && isStaff();
      allow update: if request.auth != null && (isOperator() || isManager())
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['tipo', 'activo', 'uid', 'usuarioNombre', 'usuarioRol', 'editadoEn'])
        && request.resource.data.tipo in ['repartidor', 'planta', 'interno']
        && request.resource.data.activo is bool;
      allow create, delete: if false;
    }

    // ── Padrón maestro: cola de altas automáticas de clientes desde Tango ──
    // tango-altas/{cuit}: la sync de clientes (Admin SDK) encola los CUIT de
    // Tango sin cuenta en la app y tangoAltas.ts los crea. Solo lectura para
    // quien gestiona clientes (panel de Ajustes); nadie escribe desde el cliente.
    match /tango-altas/{cuit} {
      allow read: if request.auth != null && (isOperator() || isManager() || isGerenteGeneral() || isFacturacion());
      allow write: if false;
    }

    // ── Facturación electrónica ARCA ──────────────────────────────────────────
    // Ver docs/arca/FACTURACION_ELECTRONICA.md.

    // Ticket de Acceso de ARCA (token + sign). Es una CREDENCIAL: con eso se
    // puede emitir comprobantes en nombre de Redonhielo. Nadie lo lee ni lo
    // escribe desde un cliente — solo el Admin SDK, desde las Cloud Functions.
    // Ni siquiera super_admin: no hay ningún motivo para verlo desde la app.
    match /arcaTickets/{docId} {
      allow read, write: if false;
    }

    // Estado de la factura de cada venta (uno por ventaId). El staff puede
    // MIRARLO — hace falta para saber si una venta se facturó, con qué número y
    // con qué CAE, o por qué falló. Escribir, nadie: el número correlativo y el
    // CAE los maneja la Cloud Function, y una escritura a mano acá desincroniza
    // el estado real que tiene ARCA del otro lado.
    match /facturasArca/{ventaId} {
      allow read:  if request.auth != null && isStaff();
      allow write: if false;
    }

    // ── Modelos de heladera (ficha técnica) ────────────────────────────────
    match /modelosHeladera/{modeloId} {
      // Lectura amplia a cualquier staff: la necesitan la pantalla de alta de
      // equipos, la etiqueta Zebra y el pedido de reparación impreso.
      allow read:  if request.auth != null && isStaff();
      allow write: if request.auth != null && isHeladerasFullAccess();
    }

    // ── Índice de códigos internos de heladera (anti-duplicado) ───────────
    // Mismo patrón que cuitIndex: crear pero nunca sobrescribir/borrar, así
    // dos altas simultáneas no pueden terminar con el mismo código.
    match /heladeraCodigoIndex/{codigo} {
      allow read:   if request.auth != null && isStaff();
      allow create: if request.auth != null && isHeladerasFullAccess();
      allow update, delete: if false;
    }

    // ── Pedidos recurrentes ───────────────────────────────────────────────────
    // El documento ID es el clientId. El cliente gestiona el suyo; operadores leen todos.
    match /pedidos-recurrentes/{clientId} {
      allow read, write: if request.auth != null && request.auth.uid == clientId
        && !esEscrituraImpersonada()
        && (!request.resource.data.keys().hasAny(['clientId']) || request.resource.data.clientId == request.auth.uid);
      allow read, write: if request.auth != null && isOperator();
    }

    // ── Índices de login (lectura pública — solo mapean usuario/CUIT → email)
    // El login por CUIT/DNI/legajo resuelve el email ANTES de autenticar, así
    // que el GET de un doc puntual del índice tiene que ser público (la
    // contraseña sigue siendo requerida para entrar). Pero el LIST/enumeración
    // se cierra a staff: así nadie puede listar toda la colección y armarse el
    // padrón de clientes de una sola query (auditoría 2026-08-29, H2 — scraping
    // masivo). Adivinar CUITs de a uno con get sigue siendo posible pero costoso;
    // cerrarlo del todo requiere App Check o mover el lookup a una Cloud Function
    // (fase 2). Mismo criterio para todos los índices de login de abajo.
    match /cuitIndex/{cuit} {
      allow get:  if true;
      allow list: if request.auth != null && isStaff();
      // Un cliente solo puede CREAR (nunca sobrescribir) el índice de SU
      // PROPIO CUIT, apuntando a su propio email — evita que un usuario
      // secuestre/envenene el índice de un CUIT ya asignado a otra cuenta.
      // Operadores y managers pueden escribir cualquiera en cualquier momento
      // (alta manual / importación / corrección).
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email is string
        && (
          (!exists(/databases/$(database)/documents/cuitIndex/$(cuit))
            && request.resource.data.email == request.auth.token.email)
          || isManager() || isOperator()
        );
    }

    match /choferIndex/{username} {
      allow get:  if true;
      allow list: if request.auth != null && isStaff();
      allow write: if request.auth != null && isOperator();
    }

    match /staffIndex/{username} {
      allow get:  if true;
      allow list: if request.auth != null && isStaff();
      allow write: if request.auth != null && myRole() == 'super_admin';
    }

    match /dniIndex/{dni} {
      allow get:  if true;
      allow list: if request.auth != null && isStaff();
      allow write: if request.auth != null && isOperator();
    }

    match /staffDniIndex/{dni} {
      allow get:  if true;
      allow list: if request.auth != null && isStaff();
      allow write: if request.auth != null && myRole() == 'super_admin';
    }

    match /tecnicoDniIndex/{dni} {
      allow get:  if true;
      allow list: if request.auth != null && isStaff();
      allow write: if request.auth != null && isHeladerasFullAccess();
    }

    match /produccionLegajoIndex/{legajo} {
      allow get:  if true;
      allow list: if request.auth != null && isStaff();
      allow write: if request.auth != null && isProduccionEncargado();
    }

    // ── Rollups de pedidos ─────────────────────────────────────────────────────
    // Agregados diarios (conteos por estado, bolsas, top de clientes) que
    // mantiene el trigger onOrderRollup con el Admin SDK. Los tableros de
    // gerencia los leen en vez de escanear todos los pedidos (auditoría H5). Son
    // datos no sensibles (agregados), así que los lee cualquier staff; nadie los
    // escribe desde el cliente.
    match /rollupsPedidos/{fecha} {
      allow read:  if request.auth != null && isStaff();
      allow write: if false;
    }

    // ── Auditoría del Backoffice ───────────────────────────────────────────────
    // Append-only: cualquier staff puede dejar su propio registro (nunca en
    // nombre de otro — el actor.uid tiene que ser quien escribe), pero solo
    // super_admin lo lee. Ver plan de migración del Backoffice, Fase 4.
    match /historialAdmin/{eventoId} {
      allow read:   if request.auth != null && myRole() == 'super_admin';
      allow create: if request.auth != null && isStaff()
        && request.resource.data.actor.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Despachos ─────────────────────────────────────────────────────────────
    match /despachos/{despachoId} {
      allow read: if request.auth != null && (
        isOperator() ||
        isGerenteComercial() ||
        isGerenteGeneral() ||
        request.auth.token.email == resource.data.driverId
      );
      allow write: if request.auth != null && (isOperator() || isGerenteComercial());
    }

    // ── Asignaciones diarias (camión + ayudante por chofer y fecha) ──────────
    // El documento ID es la fecha 'yyyy-MM-dd'
    match /asignacionesDia/{fecha} {
      allow read:  if request.auth != null && (isOperator() || isGerenteComercial() || isGerenteGeneral());
      allow write: if request.auth != null && (isOperator() || isGerenteComercial());
    }

    // ── Ubicaciones en tiempo real (GPS del chofer) ────────────────────────
    // El documento ID es el email del chofer
    match /ubicaciones/{driverEmail} {
      allow write: if request.auth != null && !esEscrituraImpersonada() && (
        request.auth.token.email == driverEmail || isOperator()
      );
      // Lectura: staff que ve el mapa en vivo (operadores, managers, gerente
      // general) y el propio chofer. El CLIENTE ya no lee esta colección: su
      // seguimiento del camión se resuelve server-side (trigger
      // mirrorDriverLocation espeja la posición dentro de su propio pedido),
      // para no exponerle la ubicación ni el teléfono de toda la flota.
      allow read: if request.auth != null && (
        isOperator() || isManager() || isGerenteGeneral() ||
        request.auth.token.email == driverEmail
      );
    }
  }
}
