rules_version = '2';

// Reglas de Firebase Storage. Usos: la foto de cada producto del catálogo
// (botonera de venta) y la foto del problema en un ticket de service pedido
// desde la calle. Todo lo demás queda cerrado por defecto.
service firebase.storage {
  match /b/{bucket}/o {

    // Perfil del usuario autenticado. Storage no tiene custom claims propios,
    // así que se lee el documento (una lectura por operación, igual que antes).
    function perfil() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function miRol() {
      return perfil().rol;
    }

    // Mismo criterio que firestore.rules (2026-09-13): un permiso funcional se
    // pregunta sobre el CONJUNTO de roles, no solo sobre el principal. Lucas es
    // de logística y además hace facturación: tiene que poder archivar el PDF
    // de una factura desde Recupero de facturas.
    function tieneAlguno(rs) {
      return miRol() in rs || perfil().get('rolesExtra', []).hasAny(rs);
    }

    // Fotos del catálogo: catalogo/{productoId}
    // - Lectura abierta: en la práctica el downloadURL lleva su propio token y
    //   <img> lo sirve igual; igual la dejamos pública porque son fotos de
    //   productos, nada sensible.
    // - Escritura solo managers (mismos roles que editan config/catalogo en
    //   firestore.rules → isManager()), imagen y < 2 MB (ya se redimensiona en
    //   el cliente, esto es el tope de seguridad).
    match /catalogo/{productoId} {
      allow read: if true;
      allow write: if request.auth != null
        && tieneAlguno(['super_admin', 'gerente_comercial', 'comercial'])
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Foto del problema de un ticket de service: ticketsServicio/{ticketId}/foto.jpg
    // (2026-09-07). La sube el supervisor desde la ficha del cliente (o el
    // módulo heladeras); la ve cualquier usuario logueado (el encargado la
    // abre desde Consulta de service con el downloadURL). Imagen y < 3 MB
    // (se reduce en el celular antes de subir).
    match /ticketsServicio/{ticketId}/{archivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && tieneAlguno(['supervisor', 'heladeras_encargado', 'super_admin', 'gerente_comercial'])
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Facturas de Tango archivadas por administración: facturas/{empresa}/{clave}.pdf
    // (2026-09-07, Recupero de facturas → "Guardar en la app"). Las sube
    // administración; las baja el staff (el supervisor las comparte con el
    // cliente). Nunca un cliente. PDF y < 3 MB.
    match /facturas/{empresa}/{archivo} {
      allow read: if request.auth != null && miRol() != 'cliente';
      allow write: if request.auth != null
        && tieneAlguno(['super_admin', 'facturacion'])
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // Comprobantes publicados para mandarlos por WhatsApp a un número
    // (2026-09-15, visor → Enviar): compartidos/{uid}/{fecha-archivo}. wa.me
    // no adjunta archivos a un chat elegido por número, así que el PDF se sube
    // acá y el chat lleva el link de descarga (con su token, el cliente lo abre
    // sin usuario). Escribe solo el staff, y solo en su propia carpeta.
    match /compartidos/{uid}/{archivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && miRol() != 'cliente'
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
