# Remitentes (los lee functions/src/email.ts). Desde el 2026-09-24 el
# proveedor principal es Resend Pro con el dominio rolito.com.ar verificado:
# RESEND_FROM tiene que ser de ese dominio. FROM_EMAIL es el del respaldo por
# SMTP, y Microsoft exige que coincida con la casilla que se autentica
# (SMTP_USER). Por eso son dos.
RESEND_FROM="Rolito <comprobantes@rolito.com.ar>"
FROM_EMAIL="Rolito <WebMail@redonhielo.com.ar>"
# Respuestas de los clientes a los mails automáticos (la casilla técnica no la
# lee nadie). Los envíos manuales llevan el mail del operador que los mandó.
REPLY_TO_EMAIL=Facturacion@redonhielo.com.ar

# Respaldo por SMTP (2026-09-17): Microsoft 365 de Redonhielo, casilla técnica
# WebMail (SMTP autenticado habilitado en el Centro de administración). La
# contraseña NO va acá: es el secret SMTP_PASSWORD. Microsoft restringió la
# casilla dos veces (19 y 21/09) por "envíos anómalos": por eso desde el
# 2026-09-24 es solo respaldo (secret RESEND_API_KEY para el principal; el
# webhook de rebotes usa RESEND_WEBHOOK_SECRET). Se elige con
# configuracion/notificaciones.proveedorMail = 'resend' | 'smtp'.
# Microsoft apaga el SMTP con contraseña a fines de diciembre de 2026: si el
# respaldo se quiere mantener hay que pasar a OAuth (ver email.ts).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=WebMail@redonhielo.com.ar
