# Remitente de todos los mails de la app. Lo lee functions/src/email.ts.
# Microsoft exige que coincida con la casilla que se autentica (SMTP_USER).
FROM_EMAIL="Rolito <WebMail@redonhielo.com.ar>"
# Respuestas de los clientes a los mails automáticos (la casilla técnica no la
# lee nadie). Los envíos manuales llevan el mail del operador que los mandó.
REPLY_TO_EMAIL=Facturacion@redonhielo.com.ar

# Salida SMTP (2026-09-17): Microsoft 365 de Redonhielo, casilla técnica
# WebMail (SMTP autenticado habilitado en el Centro de administración; la
# contraseña se cambió ese día y ya no la usa Bluesoft). La contraseña NO va
# acá: es el secret SMTP_PASSWORD (`firebase functions:secrets:set
# SMTP_PASSWORD`). Resend queda de respaldo (secret RESEND_API_KEY; el
# dominio rolito.com.ar sigue verificado ahí). Se elige con
# configuracion/notificaciones.proveedorMail = 'smtp' | 'resend'.
# Microsoft apaga el SMTP con contraseña a fines de diciembre de 2026: antes
# hay que pasar a OAuth (ver email.ts).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=WebMail@redonhielo.com.ar
